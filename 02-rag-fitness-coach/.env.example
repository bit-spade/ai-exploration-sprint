# ─────────────────────────────────────────────
# RAG Fitness Coach — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────

# ── LLM ──────────────────────────────────────
# Get a free key at https://aistudio.google.com → "Get API key"
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini model to use (free tier)
GEMINI_MODEL=gemini-1.5-flash

# ── Embeddings (Local SentenceTransformers or Ollama) ─────────
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
OLLAMA_BASE_URL=http://localhost:11434

# ── Vector Store (Qdrant) ─────────────────────────────────────
# Leave QDRANT_URL empty to run embedded local disk storage without Docker!
# Set QDRANT_URL=http://localhost:6333 if using Docker Qdrant.
QDRANT_URL=
QDRANT_PATH=data/qdrant_storage
QDRANT_COLLECTION=fitness_docs

# ── Retrieval ────────────────────────────────
# Number of candidates fetched from Qdrant before reranking
RETRIEVER_TOP_K=8
# Number of chunks kept after cross-encoder reranking
RERANKER_TOP_K=3

# ── Chunking ─────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Conversation Memory ───────────────────────
MEMORY_WINDOW_K=6

# ── API ──────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
